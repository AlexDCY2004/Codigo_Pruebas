{
  "name": "summerdent-desktop",
  "version": "1.0.0",
  "description": "SummerDent - Sistema de gestión dental para escritorio",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cypress run\"",
    "test:all": "vitest run && cypress run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.2",
    "lucide-react": "^1.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "cypress": "^15.18.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "jsdom": "^29.1.1",
    "vite": "^8.0.4",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.summerdent.desktop",
    "productName": "SummerDent",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
